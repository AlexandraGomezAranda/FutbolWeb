38932>>>        Case Begin
38932>>>            Case (NavigateData.eNavigateType = nfFromMain)
38934>>>                // If from main, this is a propbably a main file Select to Zoom.
38934>>>                Case Break
38935>>>
38935>>>            Case (NavigateData.eNavigateType = nfFromParent)
38938>>>                // If from parent, this is a constrained drill down.
38938>>>                Case Break
38939>>>
38939>>>            Case (NavigateData.eNavigateType = nfFromChild)
38942>>>                // If from child, this is a probably a parent Zoom from a Zoom.
38942>>>                Case Break
38943>>>
38943>>>            Case Else // must be nfUndefined
38943>>>
38943>>>        Case End
38943>>>
38943>>>        Send SetActionButtons
38944>>>        
38944>>>        If (HasRecord(Server(Self))) Begin
38946>>>            Send SetHeaderCaption   ("Liga:"*liga.Nombre)
38947>>>            Send SetBreadcrumbCaption liga.Nombre
38948>>>        End
38948>>>>
38948>>>        Else Begin
38949>>>            Send SetHeaderCaption   "Nueva Liga"
38950>>>            Send SetBreadcrumbCaption "Nuevo"
38951>>>        End 
38951>>>>
38951>>>
38951>>>    End_Procedure
