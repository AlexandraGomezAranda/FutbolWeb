37817>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
37820>>>        Case Begin
37820>>>            Case (NavigateData.eNavigateType = nfFromMain)
37822>>>                // If from main, this is a propbably a main file Select to Zoom.
37822>>>                Case Break
37823>>>
37823>>>            Case (NavigateData.eNavigateType = nfFromParent)
37826>>>                // If from parent, this is a constrained drill down.
37826>>>                Case Break
37827>>>
37827>>>            Case (NavigateData.eNavigateType = nfFromChild)
37830>>>                // If from child, this is a probably a parent Zoom from a Zoom.
37830>>>                Case Break
37831>>>
37831>>>            Case Else // must be nfUndefined
37831>>>
37831>>>        Case End
37831>>>
37831>>>        Send SetActionButtons
37832>>>        
37832>>>      
37832>>>        If (HasRecord(Server(Self))) Begin
37834>>>            Send SetHeaderCaption   ("Entrenador:"*entrenador.Nombre)
37835>>>            Send SetBreadcrumbCaption entrenador.Nombre
37836>>>        End
37836>>>>
37836>>>        Else Begin
37837>>>            Send SetHeaderCaption   "Nuevo entrenador"
37838>>>            Send SetBreadcrumbCaption "Nuevo"
37839>>>        End 
37839>>>>
37839>>>    End_Procedure
37840>>>
37840>>>End_Object 
