37789>>>    Procedure SetActionButtons
37792>>>        tWebNavigateData NavigateData
37792>>>        tWebNavigateData NavigateData
37792>>>        Boolean bHasRecord
37792>>>        Handle hoDD
37792>>>
37792>>>        Get Server to hoDD
37793>>>        Get GetNavigateData to NavigateData
37794>>>        Get HasRecord of hoDD to bHasRecord
37795>>>
37795>>>        // let's hide all buttons and then Show the ones we want
37795>>>        WebSet pbRender of oEditBtn to False
37796>>>        WebSet pbRender of oSaveBtn to False
37797>>>        WebSet pbRender of oCancelChangesBtn to False
37798>>>        WebSet pbRender of oDeleteBtn to False
37799>>>
37799>>>        If (NavigateData.bReadOnly) Begin
37801>>>            WebSet pbRender of oEditBtn to True
37802>>>        End
37802>>>>
37802>>>        Else Begin
37803>>>            WebSet pbRender of oSaveBtn to True
37804>>>            WebSet pbRender of oCancelChangesBtn to True
37805>>>            WebSet pbRender of oDeleteBtn to bHasRecord
37806>>>        End
37806>>>>
37806>>>    End_Procedure
37807>>>
