38443>>>        Get GetNavigateData to NavigateData
38444>>>        Get HasRecord of hoDD to bHasRecord
38445>>>
38445>>>        // let's hide all buttons and then Show the ones we want
38445>>>        WebSet pbRender of oEditBtn to False
38446>>>        WebSet pbRender of oSaveBtn to False
38447>>>        WebSet pbRender of oCancelChangesBtn to False
38448>>>        WebSet pbRender of oDeleteBtn to False
38449>>>
38449>>>        If (NavigateData.bReadOnly) Begin
38451>>>            WebSet pbRender of oEditBtn to True
38452>>>        End
38452>>>>
38452>>>        Else Begin
38453>>>            WebSet pbRender of oSaveBtn to True
38454>>>            WebSet pbRender of oCancelChangesBtn to True
38455>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38456>>>        End
38456>>>>
38456>>>    End_Procedure
