37750>>>        Else Begin
37751>>>            WebSet pbRender of oSaveBtn to True
37752>>>            WebSet pbRender of oCancelChangesBtn to True
37753>>>            WebSet pbRender of oDeleteBtn to bHasRecord
37754>>>        End
37754>>>>
37754>>>    End_Procedure
