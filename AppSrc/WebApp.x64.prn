37743>>>        WebSet pbRender of oEditBtn to False
37744>>>        WebSet pbRender of oSaveBtn to False
37745>>>        WebSet pbRender of oCancelChangesBtn to False
37746>>>        WebSet pbRender of oDeleteBtn to False
37747>>>
37747>>>        If (NavigateData.bReadOnly) Begin
37749>>>            WebSet pbRender of oEditBtn to True
37750>>>        End
